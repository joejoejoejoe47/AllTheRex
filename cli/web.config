<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Internal code: never served over HTTP. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="cli" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
