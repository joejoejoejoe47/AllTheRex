    function updateCoinsDisplay() {
      document.getElementById('player-coins').innerText = userCoins;
      document.getElementById('player-score').innerText = playerScore;
      document.getElementById('arena-game-coins').innerText = arenaGameCoins;
      saveCurrentProgress();
