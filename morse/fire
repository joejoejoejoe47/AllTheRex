  <script>
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    
    function playBeep(freq = 440, type = 'sine', duration = 0.1) {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type;
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    }

    function playVictoryMelody() {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const notes = [523.25, 659.25, 783.99, 1046.50];
      notes.forEach((freq, idx) => {
        setTimeout(() => {
          playBeep(freq, 'triangle', 0.25);
        }, idx * 180);
      });
    }

    function playShhSound() {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const bufferSize = audioCtx.sampleRate * 1.5;
      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = Math.random() * 2 - 1;
      }

      const noise = audioCtx.createBufferSource();
      noise.buffer = buffer;

      const filter = audioCtx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.value = 800;
      filter.Q.value = 2;

      const gain = audioCtx.createGain();
      gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 1.5);

      noise.connect(filter);
      filter.connect(gain);
      gain.connect(audioCtx.destination);
      noise.start();
    }

    let currentAccountName = '';
    let userCoins = 1500;
    let playerScore = 0;
    let arenaGameCoins = 0;

    function showCreateAccountInput() {
      playBeep(600, 'sine', 0.1);
      const panel = document.getElementById('auth-main-panel');
      panel.innerHTML = `
        <h2>Create Super Account</h2>
        <p style="color: #cbd5e1; font-size: 0.95rem; margin: 0;">Type in any account name to begin.</p>
        <div class="auth-input-group">
          <input type="text" id="account-name-input" placeholder="Enter Any Account Name..." autofocus>
          <button class="auth-btn" onclick="submitCreateAccount()">Create New Account</button>
        </div>
      `;
    }

    function submitCreateAccount() {
      const inputVal = document.getElementById('account-name-input').value.trim();
      if (!inputVal) {
        alert("Please enter a valid account name!");
        return;
      }
      currentAccountName = inputVal;
      
      initializeFreshRosters();
      userCoins = 1500;
      playerScore = 0;
      saveCurrentProgress();

      playBeep(880, 'sine', 0.3);
      enterGame();
    }

    function showOpenAccountInput() {
      playBeep(600, 'sine', 0.1);
      const panel = document.getElementById('auth-main-panel');
      panel.innerHTML = `
        <h2>Open Super Account</h2>
        <p style="color: #cbd5e1; font-size: 0.95rem; margin: 0;">Type in your existing account name to open your super account.</p>
        <div class="auth-input-group">
          <input type="text" id="account-name-input" placeholder="Enter Account Name..." autofocus>
          <button class="auth-btn" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9); box-shadow: 0 0 25px rgba(139, 92, 246, 0.7);" onclick="submitOpenAccount()">Open Your Super Account</button>
        </div>
      `;
    }

    function submitOpenAccount() {
      const inputVal = document.getElementById('account-name-input').value.trim();
      if (!inputVal) {
        alert("Please enter a valid account name!");
        return;
      }
      
      const savedData = localStorage.getItem(`super_account_${inputVal}`);
      if (!savedData) {
        currentAccountName = inputVal;
        initializeFreshRosters();
        userCoins = 1500;
        playerScore = 0;
        saveCurrentProgress();
        playBeep(880, 'sine', 0.3);
        enterGame();
        return;
      }

      currentAccountName = inputVal;
      const parsed = JSON.parse(savedData);
      userCoins = parsed.userCoins ?? 1500;
      playerScore = parsed.playerScore ?? 0;
      if (parsed.unitRoster) {
        for (let tier in parsed.unitRoster) {
          if (unitRoster[tier]) {
            parsed.unitRoster[tier].forEach((savedU, idx) => {
              if (unitRoster[tier][idx]) {
                unitRoster[tier][idx].owned = savedU.owned;
              }
            });
          }
        }
      }

      playBeep(880, 'sine', 0.3);
      enterGame();
    }

    function initializeFreshRosters() {
      unitRoster.easy = generateTierRoster('easy', 0, 70, 14);
      unitRoster.medium = generateTierRoster('medium', 400, 110, 25);
      unitRoster.hard = generateTierRoster('hard', 1500, 180, 42);
      unitRoster.legendary = generateTierRoster('legendary', 5000, 300, 75);
    }

    function saveCurrentProgress() {
      if (!currentAccountName) return;
      const dataToSave = {
        userCoins,
        playerScore,
        unitRoster
      };
      localStorage.setItem(`super_account_${currentAccountName}`, JSON.stringify(dataToSave));
    }

    function enterGame() {
      document.getElementById('auth-page').style.display = 'none';
      document.getElementById('tiny-home-btn').style.display = 'block';
      renderShop();
      updateCoinsDisplay();
    }

    function returnToHome() {
      playBeep(400, 'sine', 0.1);
      saveCurrentProgress();
      document.getElementById('tiny-home-btn').style.display = 'none';
      const authPage = document.getElementById('auth-page');
      authPage.style.display = 'flex';
      
      document.getElementById('auth-main-panel').innerHTML = `
        <h2>Super Account Portal</h2>
        <p style="color: #cbd5e1; font-size: 0.95rem; margin: 0;">Choose an option to begin your journey or restore your saved progress.</p>
        <div style="display: flex; flex-direction: column; gap: 12px; width: 100%; margin-top: 10px;">
