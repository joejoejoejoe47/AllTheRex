    function buyScorePoints() {
      const cost = 200;
      if (userCoins < cost) {
        alert("Not enough coins to buy score! You need 200 coins.");
        playBeep(150, 'sawtooth', 0.2);
        return;
      }
      userCoins -= cost;
      playerScore += 10;
      updateCoinsDisplay();
      playBeep(900, 'sine', 0.3);
    }

