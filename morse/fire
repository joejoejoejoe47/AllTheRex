        "Eclipse Hero", "Zenith Protector", "Astral Knight", "Brave Stryker", "Heroic Spirit",
        "Courage Ranger", "Neon Guardian", "Flash Defender", "Alpha Champion", "Prime Paladin",
        "True Warrior", "Pure Sentinel", "Kind Guardian", "Noble Hero", "Graceful Champion",
        "Serene Defender", "Bright Shield", "Radiant Paladin", "Stellar Knight", "Solar Warrior",
        "Lunar Vanguard", "Hyper Crusader", "Atomic Champion", "Mega Master", "Super Guardian",
        "Power Defender", "Swift Knight", "Grand Paladin", "Ultimate Hero", "Supreme Champion"
      ];
      
      for (let i = 1; i <= 50; i++) {
        let uniqueGlobalId = (tierName === 'easy' ? 100 : tierName === 'medium' ? 300 : tierName === 'hard' ? 500 : 700) + i;
        let pName = goodHeroNames[(i - 1) % goodHeroNames.length];
        let pPrice = i <= 3 ? 0 : basePrice + ((i - 3) * (tierName === 'easy' ? 25 : tierName === 'medium' ? 60 : tierName === 'hard' ? 120 : 250));
        let pHp = baseHp + (i * 2);
        let pPwr = basePower + Math.floor(i / 2);
        let pPowObj = superpowerTypes[i % superpowerTypes.length];
        let isOwned = i <= 3;
        let photoUrl = getLiveActionPhotoURL(uniqueGlobalId, false);

        roster.push({
          id: `${tierName[0]}${i}`,
          tier: tierName,
          name: pName,
          price: pPrice,
          hp: pHp,
          power: pPwr,
          range: 1,
          photoUrl: photoUrl,
          owned: isOwned,
          powerObj: pPowObj
        });
      }
      return roster;
    }

    const unitRoster = {
      easy: generateTierRoster('easy', 0, 70, 14),
      medium: generateTierRoster('medium', 400, 110, 25),
      hard: generateTierRoster('hard', 1500, 180, 42),
      legendary: generateTierRoster('legendary', 5000, 300, 75)
    };

    function switchCategory(cat) {
      currentCategory = cat;
      document.getElementById('cat-easy-btn').classList.toggle('active', cat === 'easy');
      document.getElementById('cat-med-btn').classList.toggle('active', cat === 'medium');
      document.getElementById('cat-hard-btn').classList.toggle('active', cat === 'hard');
      document.getElementById('cat-leg-btn').classList.toggle('active', cat === 'legendary');
      renderShop();
    }

    function renderShop() {
      const container = document.getElementById('shop-cards-container');
      container.innerHTML = '';

      const list = unitRoster[currentCategory];
      list.forEach(f => {
        const card = document.createElement('div');
        card.className = `fighter-card`;
        
        let buttonHTML = f.owned ? 
          `<button class="buy-btn owned">UNLOCKED</button>` : 
          `<button class="buy-btn" onclick="buyUnit('${f.tier}', '${f.id}')">BUY FOR $${f.price}</button>`;

        card.innerHTML = `
          <div class="avatar-box"><img src="${f.photoUrl}" alt="${f.name}" loading="lazy"></div>
          <div class="title">${f.name}</div>
          <div class="stats">
            <span>❤️ Health: <strong>${f.hp} HP</strong></span>
            <span>⚔️ Attack: <strong>${f.power}</strong></span>
          </div>
          <div class="superpower-desc">⚡ <strong>${f.powerObj.name}</strong>: ${f.powerObj.desc}</div>
          <div style="font-weight:900; color:var(--neon-gold); font-size:1rem;">${f.price === 0 ? 'FREE (Starter)' : `$${f.price} Coins`}</div>
          ${buttonHTML}
        `;
        container.appendChild(card);
      });
    }

    function buyUnit(tier, uId) {
      const unit = unitRoster[tier].find(u => u.id === uId);
      if (!unit) return;
      if (userCoins < unit.price) {
        alert("Not enough coins to purchase this real superhero!");
        playBeep(150, 'sawtooth', 0.2);
        return;
      }

      userCoins -= unit.price;
      unit.owned = true;
      updateCoinsDisplay();
      playBeep(880, 'sine', 0.3);
      renderShop();
    }

    let activeSquadTier = 'easy';
    let selectedSquadIds = [];
    let targetSquadSize = 5;

    function prepSquadSelection(tier) {
      playBeep(500, 'sine', 0.2);
      activeSquadTier = tier;
      selectedSquadIds = [];
      targetSquadSize = 5;

      document.getElementById('squad-tier-name').innerText = tier;
      const slider = document.getElementById('squad-count-slider');
      slider.min = 5;
      slider.value = 5;
      document.getElementById('slider-target-val').innerText = 5;
      document.getElementById('max-target-display').innerText = 5;
      document.getElementById('target-req-label').innerText = 5;

      document.getElementById('arena-select-step').style.display = 'none';
      document.getElementById('arena-squad-step').style.display = 'flex';
      
      renderSquadSelector();
      updateSquadSelectionUI();
    }

    function onSliderChange(val) {
      let parsedVal = parseInt(val);
      if (parsedVal < 5) parsedVal = 5;
      targetSquadSize = parsedVal;
      document.getElementById('slider-target-val').innerText = targetSquadSize;
      document.getElementById('max-target-display').innerText = targetSquadSize;
      document.getElementById('target-req-label').innerText = targetSquadSize;
      
      if (selectedSquadIds.length > targetSquadSize) {
        selectedSquadIds = selectedSquadIds.slice(0, targetSquadSize);
      }
      renderSquadSelector();
      updateSquadSelectionUI();
    }

    function renderSquadSelector() {
      const container = document.getElementById('squad-select-cards-container');
      container.innerHTML = '';

      const ownedUnits = unitRoster[activeSquadTier].filter(u => u.owned);
      if (ownedUnits.length === 0) {
        container.innerHTML = `<p style="color:var(--neon-pink); grid-column: 1/-1;">No good superheroes unlocked in this tier!</p>`;
        return;
      }

      ownedUnits.forEach(u => {
        const isSelected = selectedSquadIds.includes(u.id);
        const card = document.createElement('div');
        card.className = `select-unit-card ${isSelected ? 'selected-squad' : ''}`;
        card.onclick = () => toggleSquadMember(u.id);

        card.innerHTML = `
          <div style="width:48px; height:48px; border-radius:50%; overflow:hidden; border:2px solid var(--neon-cyan); background:#000;"><img src="${u.photoUrl}" alt="${u.name}" style="width:100%; height:100%; object-fit:cover;"></div>
          <div style="font-weight:700; font-size:0.85rem; color:#fff;">${u.name}</div>
          <div style="font-size:0.75rem; color:#cbd5e1;">❤️ ${u.hp}HP | ⚔️ ${u.power}</div>
          <div style="font-size:0.65rem; color:var(--neon-gold);">${u.powerObj.name}</div>
        `;
        container.appendChild(card);
      });
    }

    function toggleSquadMember(uId) {
      const unit = unitRoster[activeSquadTier].find(u => u.id === uId);
      if (!unit) return;

      playBeep(520, 'sine', 0.05);
      if (selectedSquadIds.includes(uId)) {
        selectedSquadIds = selectedSquadIds.filter(id => id !== uId);
      } else {
        if (selectedSquadIds.length >= targetSquadSize) {
          alert(`You can select up to ${targetSquadSize} squad heroes based on your target size slider!`);
          return;
        }

        if (unit.powerObj.type === 'bomber') {
          const alreadyHasBomber = selectedSquadIds.some(id => {
            const squadU = unitRoster[activeSquadTier].find(item => item.id === id);
            return squadU && squadU.powerObj.type === 'bomber';
          });
          if (alreadyHasBomber) {
            alert("You can only play with one Bomb Layer unit in your squad!");
            return;
          }
        }

        selectedSquadIds.push(uId);
      }
      renderSquadSelector();
      updateSquadSelectionUI();
    }

    function updateSquadSelectionUI() {
      document.getElementById('selected-count').innerText = selectedSquadIds.length;
      document.getElementById('launch-battle-btn').disabled = selectedSquadIds.length !== targetSquadSize;
    }

    let GRID_COLS = 8;
    let GRID_ROWS = 6;
    let gridBoardState = []; 
    let playerBattleUnits = [];
    let enemyBattleUnits = [];
    let selectedUnit = null;
    let isPlayerTurn = true;
    let specialModeActive = null; 

    let enemyTitanThrowsLeft = 3;
    let userInvisibilityUsesLeft = 5;
    let enemyBaseBuilt = false;

    let playerHasActiveBomb = false;
    let playerPlacedBombCoords = null; 
    let enemyPlacedBomb = null; 

    function confirmAndStartBattle() {
      if (selectedSquadIds.length < 5) {
        alert("You must select at least 5 units to play (Squad size range is 5 to 20).");
        return;
      }

      playBeep(700, 'sine', 0.2);
      playerBattleUnits = [];
      arenaGameCoins = 0;
      enemyBaseBuilt = false;
      playerHasActiveBomb = false;
      playerPlacedBombCoords = null;
      enemyPlacedBomb = null;

      selectedSquadIds.forEach(id => {
        const u = unitRoster[activeSquadTier].find(item => item.id === id);
        if (u) {
          playerBattleUnits.push({
            id: u.id,
            tier: u.tier,
            name: u.name,
            hp: u.hp,
            maxHp: u.hp,
            power: u.power,
            range: 1,
            photoUrl: u.photoUrl,
            isPlayer: true,
            actionsLeft: 2,
            powerObj: u.powerObj,
            invisibleTurnsLeft: 0,
            fadingSlowly: false,
            completelyInvisible: false,
            baseActiveTurns: 0,
            hasBaseTile: null
          });
        }
      });

      const enemyCount = Math.max(5, playerBattleUnits.length);
      enemyBattleUnits = [];
      let enemyHp = 70, enemyPower = 14, enemyNamePrefix = "Shadow Boss";

      if (activeSquadTier === 'medium') { enemyHp = 110; enemyPower = 25; enemyNamePrefix = "Shadow Boss"; }
      else if (activeSquadTier === 'hard') { enemyHp = 180; enemyPower = 42; enemyNamePrefix = "Overlord Villain"; }
      else if (activeSquadTier === 'legendary') { enemyHp = 300; enemyPower = 75; enemyNamePrefix = "Supreme Nemesis"; }

      const bossTypes = ['titan', 'speedster', 'invisible', 'bomber', 'shield'];

      for (let i = 0; i < enemyCount; i++) {
        let bType = bossTypes[i % bossTypes.length];
        let villainPhotoUrl = `https://picsum.photos/seed/villain${activeSquadTier}_${i}/150/150`;

        enemyBattleUnits.push({
          id: `enemy_${i}`,
          name: `${enemyNamePrefix} #${i + 1}`,
          hp: enemyHp,
          maxHp: enemyHp,
          power: enemyPower,
          range: 1,
          photoUrl: villainPhotoUrl,
          isPlayer: false,
          actionsLeft: 2,
          bossType: bType,
          moveStateIndex: 0, 
          invisibleTurnsLeft: 0,
          enemyInvisUsesLeft: 3,
          fadingSlowly: false,
          completelyInvisible: false,
          baseActiveTurns: 0,
          hasBaseTile: null
        });
      }

      let extraSize = Math.floor((playerBattleUnits.length - 5) / 2) * 2;
      GRID_COLS = 8 + extraSize;
      GRID_ROWS = 6 + Math.floor(extraSize / 2);

      enemyTitanThrowsLeft = 3;
      userInvisibilityUsesLeft = 5;
      initGridBoardPositions();
      isPlayerTurn = true;
      selectedUnit = null;
      specialModeActive = null;

      document.getElementById('arena-squad-step').style.display = 'none';
      document.getElementById('arena-fight-step').style.display = 'flex';
      document.getElementById('turn-indicator').innerText = "Your Turn";

      renderGridBoard();
      updateCoinsDisplay();
      updateBattleHUD();
    }

    function initGridBoardPositions() {
      gridBoardState = Array(GRID_ROWS).fill(null).map(() => Array(GRID_COLS).fill(null));
      
      let pIdx = 0;
      for (let c = 0; c < 2 && pIdx < playerBattleUnits.length; c++) {
        for (let r = 0; r < GRID_ROWS && pIdx < playerBattleUnits.length; r++) {
          gridBoardState[r][c] = playerBattleUnits[pIdx++];
        }
      }
      while(pIdx < playerBattleUnits.length) {
        for (let r = 0; r < GRID_ROWS; r++) {
          for (let c = 0; c < GRID_COLS; c++) {
            if (!gridBoardState[r][c] && pIdx < playerBattleUnits.length) {
              gridBoardState[r][c] = playerBattleUnits[pIdx++];
            }
          }
        }
      }

      let eIdx = 0;
      for (let c = GRID_COLS - 1; c >= GRID_COLS - 2 && eIdx < enemyBattleUnits.length; c--) {
        for (let r = 0; r < GRID_ROWS && eIdx < enemyBattleUnits.length; r++) {
          if (!gridBoardState[r][c]) {
            gridBoardState[r][c] = enemyBattleUnits[eIdx++];
          }
        }
      }
      while(eIdx < enemyBattleUnits.length) {
        for (let r = 0; r < GRID_ROWS; r++) {
          for (let c = GRID_COLS - 1; c >= 0; c--) {
            if (!gridBoardState[r][c] && eIdx < enemyBattleUnits.length) {
              gridBoardState[r][c] = enemyBattleUnits[eIdx++];
            }
          }
        }
      }
    }

    function renderGridBoard() {
      const boardEl = document.getElementById('grid-board');
      boardEl.innerHTML = '';
      boardEl.style.gridTemplateColumns = `repeat(${GRID_COLS}, 1fr)`;
      boardEl.style.gridTemplateRows = `repeat(${GRID_ROWS}, 1fr)`;

      for (let r = 0; r < GRID_ROWS; r++) {
        for (let c = 0; c < GRID_COLS; c++) {
          const cell = document.createElement('div');
          cell.className = 'grid-cell';
          cell.dataset.row = r;
          cell.dataset.col = c;

          let hasBaseHere = false;
          [...playerBattleUnits, ...enemyBattleUnits].forEach(u => {
            if (u.hasBaseTile && u.hasBaseTile.r === r && u.hasBaseTile.c === c && u.baseActiveTurns > 0) {
              hasBaseHere = true;
            }
          });

          if (hasBaseHere) {
            cell.classList.add('has-base');
          }

          if (playerHasActiveBomb && playerPlacedBombCoords && playerPlacedBombCoords.r === r && playerPlacedBombCoords.c === c) {
            cell.classList.add('has-player-bomb');
          }

          const unit = gridBoardState[r][c];
          if (unit) {
            const unitEl = document.createElement('div');
            let unitClass = `grid-unit ${unit.isPlayer ? 'player' : 'enemy'}`;
            
            if (!unit.isPlayer && unit.completelyInvisible) {
              unitClass += ' completely-invisible';
            } else if (unit.fadingSlowly) {
              unitClass += ' fading-slowly';
            }

            if (selectedUnit === unit) {
              unitClass += ' selected';
            }
            unitEl.className = unitClass;
            unitEl.innerHTML = `<img src="${unit.photoUrl}" alt="${unit.name}">`;

            const badge = document.createElement('div');
            badge.className = 'unit-badge';
            badge.innerText = unit.invisibleTurnsLeft > 0 ? `inv:${unit.invisibleTurnsLeft}` : unit.actionsLeft;
            unitEl.appendChild(badge);

            const hpPip = document.createElement('div');
            hpPip.className = 'unit-hp-pip';
            hpPip.innerText = `${unit.hp}HP`;
            unitEl.appendChild(hpPip);

            cell.appendChild(unitEl);
          }

          if (selectedUnit && selectedUnit.isPlayer && isPlayerTurn && selectedUnit.actionsLeft > 0) {
            const selectedPos = findUnitPosition(selectedUnit);
            if (selectedPos) {
              const dist = Math.abs(selectedPos.r - r) + Math.abs(selectedPos.c - c);
              let maxMove = selectedUnit.powerObj.type === 'speed' ? 4 : 1;

              if (specialModeActive === 'throw_target') {
                if (!unit && dist <= 3) cell.classList.add('highlight-throw');
              } else if (specialModeActive === 'lay_bomb') {
                if (!unit && dist <= 1 && !(playerPlacedBombCoords && playerPlacedBombCoords.r === r && playerPlacedBombCoords.c === c)) {
                  cell.classList.add('highlight-bomb');
                }
              } else {
                if (selectedUnit.baseActiveTurns > 0) {
                } else {
                  if (dist <= maxMove && !unit) cell.classList.add('highlight-move');
                }
                
                let targetInBase = unit && unit.baseActiveTurns > 0;
                if (dist <= 1 && unit && !unit.isPlayer && !unit.completelyInvisible && !targetInBase) {
                  cell.classList.add('highlight-attack');
                }
              }
            }
          }

          cell.onclick = () => handleCellClick(r, c);
          boardEl.appendChild(cell);
        }
      }
      renderSpecialControls();
    }

    function renderSpecialControls() {
      const controlsEl = document.getElementById('extra-ability-controls');
      controlsEl.innerHTML = '';

      const containerDiv = document.createElement('div');
      containerDiv.style.display = 'flex';
      containerDiv.style.gap = '10px';
      containerDiv.style.alignItems = 'center';
      containerDiv.style.flexWrap = 'wrap';
      containerDiv.style.justifyContent = 'center';

      const endTurnBtn = document.createElement('button');
      endTurnBtn.className = 'action-btn danger';
      endTurnBtn.innerText = `🛑 End Turn`;
      endTurnBtn.onclick = () => triggerEndTurnButton();
      containerDiv.appendChild(endTurnBtn);

      const quitBtn = document.createElement('button');
      quitBtn.className = 'action-btn danger';
      quitBtn.style.background = 'linear-gradient(135deg, #7f1d1d, #450a0a)';
      quitBtn.innerText = `❌ Quit Arena (-8 Score)`;
      quitBtn.onclick = () => triggerQuitArena();
      containerDiv.appendChild(quitBtn);

      if (selectedUnit && selectedUnit.isPlayer) {
        const skipBtn = document.createElement('button');
        skipBtn.className = 'action-btn';
        skipBtn.style.borderColor = 'var(--neon-cyan)';
        skipBtn.innerText = `⏭️ Skip Unit`;
        skipBtn.onclick = () => skipSelectedUnitTurn();
        containerDiv.appendChild(skipBtn);

        const buildBaseBtn = document.createElement('button');
        buildBaseBtn.className = 'action-btn special';
        buildBaseBtn.disabled = selectedUnit.baseActiveTurns > 0 || selectedUnit.hasBaseTile !== null;
        buildBaseBtn.innerText = selectedUnit.baseActiveTurns > 0 ? `Base Active (${selectedUnit.baseActiveTurns} turns)` : `🏗️ Build Base (Cost: 1 Coin)`;
        buildBaseBtn.onclick = () => buildBaseForUnit();
        containerDiv.appendChild(buildBaseBtn);

        if (selectedUnit.powerObj.type === 'bomber') {
          const bombBtn = document.createElement('button');
          bombBtn.className = `action-btn special ${specialModeActive === 'lay_bomb' ? 'danger' : ''}`;
          bombBtn.disabled = playerHasActiveBomb;
          bombBtn.innerText = specialModeActive === 'lay_bomb' ? 'Cancel Bomb' : (playerHasActiveBomb ? 'Bomb Active (1 Max)' : '💣 Lay Bomb (1 Active)');
          bombBtn.onclick = () => toggleLayBomb();
          containerDiv.appendChild(bombBtn);

          const buyBombBtn = document.createElement('button');
          buyBombBtn.className = 'action-btn';
          buyBombBtn.style.borderColor = 'var(--neon-gold)';
          buyBombBtn.style.color = 'var(--neon-gold)';
          buyBombBtn.innerText = `🪙 Buy Bomb ($2 Coins)`;
          buyBombBtn.onclick = () => buyNewBombRecharge();
          containerDiv.appendChild(buyBombBtn);
        }

        if (selectedUnit.powerObj.type === 'strength') {
          const throwBtn = document.createElement('button');
          throwBtn.className = `action-btn special ${specialModeActive === 'throw_target' ? 'danger' : ''}`;
          throwBtn.innerText = specialModeActive === 'throw_target' ? 'Cancel Throw' : `⚡ Titan Throw (${enemyTitanThrowsLeft} left)`;
          throwBtn.onclick = () => toggleLiftAndThrow();
          containerDiv.appendChild(throwBtn);

          const buyThrowBtn = document.createElement('button');
          buyThrowBtn.className = 'action-btn';
          buyThrowBtn.style.borderColor = 'var(--neon-gold)';
          buyThrowBtn.style.color = 'var(--neon-gold)';
          buyThrowBtn.innerText = `🪙 Spend 1 Coin (+1 Throw)`;
          buyThrowBtn.onclick = () => spendCoinForTitanThrow();
          containerDiv.appendChild(buyThrowBtn);

        } else if (selectedUnit.powerObj.type === 'invisible') {
          const invBtn = document.createElement('button');
          invBtn.className = 'action-btn special';
          invBtn.disabled = selectedUnit.invisibleTurnsLeft > 0 || userInvisibilityUsesLeft <= 0;
          invBtn.innerText = selectedUnit.invisibleTurnsLeft > 0 ? `Invisibility Active` : `⚡ Quantum Stealth (${userInvisibilityUsesLeft} left)`;
          invBtn.onclick = () => activateInvisibility();
          containerDiv.appendChild(invBtn);

          const buyInvBtn = document.createElement('button');
          buyInvBtn.className = 'action-btn';
          buyInvBtn.style.borderColor = 'var(--neon-gold)';
          buyInvBtn.style.color = 'var(--neon-gold)';
          buyInvBtn.innerText = `🪙 Spend 1 Coin (+1 Invisibility)`;
          buyInvBtn.onclick = () => spendCoinForInvisibility();
          containerDiv.appendChild(buyInvBtn);
        }
      }

      controlsEl.appendChild(containerDiv);
    }

    function toggleLayBomb() {
      playBeep(600, 'sine', 0.1);
      if (specialModeActive === 'lay_bomb') {
        specialModeActive = null;
        document.getElementById('arena-status').innerText = `Selected: ${selectedUnit.name}`;
      } else {
        if (playerHasActiveBomb) {
          alert("You already have an active bomb laid! You can only have 1 active bomb at a time, or buy a new one for 2 game coins.");
          return;
        }
        specialModeActive = 'lay_bomb';
        document.getElementById('arena-status').innerText = `Click an adjacent empty tile to lay your active bomb!`;
      }
      renderGridBoard();
    }

    function buyNewBombRecharge() {
      if (arenaGameCoins < 2) {
        alert("You need at least 2 game coins earned from defeating enemies to buy a new bomb recharge!");
        playBeep(150, 'sawtooth', 0.2);
        return;
      }
      arenaGameCoins -= 2;
      playerHasActiveBomb = false; 
      playerPlacedBombCoords = null;
      playBeep(950, 'sine', 0.4);
      updateCoinsDisplay();
      document.getElementById('arena-status').innerText = `Bomb recharged! You can now lay a new bomb.`;
      renderGridBoard();
    }

    function triggerQuitArena() {
      playBeep(150, 'sawtooth', 0.3);
      isPlayerTurn = false;
      playerBattleUnits.forEach(u => u.hp = 0); 
      
      playerScore = Math.max(0, playerScore - 8); 
      updateCoinsDisplay();

      document.getElementById('game-over-modal').classList.add('show'); 
    }

    function triggerEndTurnButton() {
      if (!isPlayerTurn) return;
      playBeep(350, 'sawtooth', 0.15);
      
      playerBattleUnits.forEach(u => {
        if (u.hp > 0) u.actionsLeft = 0;
      });

      selectedUnit = null;
      specialModeActive = null;
      unitToThrow = null;
      titanPosRef = null;

      document.getElementById('arena-status').innerText = `Turn ended manually. Enemy taking turn...`;
      renderGridBoard();
      checkTurnCompletion();
    }

    function buildBaseForUnit() {
      if (!selectedUnit || !selectedUnit.isPlayer) return;
      if (arenaGameCoins < 1) {
        alert("It costs one game coin to build a base! Earn coins by defeating enemy units.");
        playBeep(150, 'sawtooth', 0.2);
        return;
      }

      const pos = findUnitPosition(selectedUnit);
      if (!pos) return;

      arenaGameCoins--;
      selectedUnit.baseActiveTurns = 2;
      selectedUnit.hasBaseTile = { r: pos.r, c: pos.c };
      selectedUnit.hp = selectedUnit.maxHp;
      
      playBeep(950, 'sine', 0.4);
      updateCoinsDisplay();
      document.getElementById('arena-status').innerText = `${selectedUnit.name} built a base!`;
      
      renderGridBoard();
      updateBattleHUD();
    }

    function skipSelectedUnitTurn() {
      if (!selectedUnit || !selectedUnit.isPlayer) return;
      playBeep(400, 'sine', 0.1);
      selectedUnit.actionsLeft = 0;
      selectedUnit = null;
      specialModeActive = null;
      unitToThrow = null;
      titanPosRef = null;
      document.getElementById('arena-status').innerText = `Unit turn skipped.`;
      renderGridBoard();
      checkTurnCompletion();
    }

    function spendCoinForInvisibility() {
      if (arenaGameCoins < 1) {
        alert("You need at least 1 game coin earned from killing an enemy to spend on invisibility!");
        playBeep(150, 'sawtooth', 0.2);
        return;
      }
      arenaGameCoins--;
      userInvisibilityUsesLeft++;
      playBeep(950, 'sine', 0.3);
      updateCoinsDisplay();
      renderGridBoard();
    }

    function spendCoinForTitanThrow() {
      if (arenaGameCoins < 1) {
        alert("You need at least 1 game coin earned from killing an enemy to spend on Titan throw!");
        playBeep(150, 'sawtooth', 0.2);
        return;
      }
      arenaGameCoins--;
      enemyTitanThrowsLeft++;
      playBeep(950, 'sine', 0.3);
      updateCoinsDisplay();
      renderGridBoard();
    }

    function activateInvisibility() {
      if (!selectedUnit || selectedUnit.powerObj.type !== 'invisible') return;
      if (userInvisibilityUsesLeft <= 0) {
        alert("You have no invisibility turns left! Spend a game coin to get more.");
        return;
      }

      playShhSound();
      userInvisibilityUsesLeft--;
      selectedUnit.fadingSlowly = true;
      selectedUnit.invisibleTurnsLeft = 3;
      selectedUnit.actionsLeft = Math.max(0, selectedUnit.actionsLeft - 1);
      
      document.getElementById('arena-status').innerText = `Shhh... ${selectedUnit.name} vanishes into quantum stealth!`;
      renderGridBoard();
      updateBattleHUD();

      if (selectedUnit.actionsLeft <= 0) selectedUnit = null;
      checkTurnCompletion();
    }

    let unitToThrow = null;
    let titanPosRef = null;

    function toggleLiftAndThrow() {
      playBeep(600, 'sine', 0.1);
      if (specialModeActive === 'throw_target') {
        specialModeActive = null;
        unitToThrow = null;
        titanPosRef = null;
        document.getElementById('arena-status').innerText = `Selected: ${selectedUnit.name}`;
      } else {
        if (enemyTitanThrowsLeft <= 0) {
          alert("Titan throw uses exhausted! Spend a game coin to get another throw.");
          return;
        }

        const pos = findUnitPosition(selectedUnit);
        let adjacentEnemy = false;
        if (pos) {
          for (let dr = -1; dr <= 1; dr++) {
            for (let dc = -1; dc <= 1; dc++) {
              if (Math.abs(dr) + Math.abs(dc) === 1) {
                let nr = pos.r + dr, nc = pos.c + dc;
                if (nr >= 0 && nr < GRID_ROWS && nc >= 0 && nc < GRID_COLS) {
                  let occupant = gridBoardState[nr][nc];
                  let occupantInBase = occupant && occupant.baseActiveTurns > 0;
                  if (occupant && !occupant.isPlayer && !occupant.completelyInvisible && !occupantInBase) adjacentEnemy = true;
                }
              }
            }
          }
        }

        if (!adjacentEnemy) {
          alert("Must stand adjacent to a visible villain not in a base to use Titan Throw!");
          return;
        }

        specialModeActive = 'throw_target';
        document.getElementById('arena-status').innerText = `Click the adjacent visible villain to twirl and throw!`;
      }
      renderGridBoard();
    }

    function findUnitPosition(targetUnit) {
      for (let r = 0; r < GRID_ROWS; r++) {
        for (let c = 0; c < GRID_COLS; c++) {
          if (gridBoardState[r][c] === targetUnit) return { r, c };
        }
      }
      return null;
    }

    function handleCellClick(r, c) {
      if (!isPlayerTurn) return;

      const clickedUnit = gridBoardState[r][c];

      if (clickedUnit && !clickedUnit.isPlayer && clickedUnit.completelyInvisible) {
        return;
      }

      if (clickedUnit && clickedUnit.isPlayer) {
        playBeep(450, 'sine', 0.08);
        selectedUnit = clickedUnit;
        specialModeActive = null;
        unitToThrow = null;
        titanPosRef = null;
        renderGridBoard();
        document.getElementById('arena-status').innerText = `Selected: ${clickedUnit.name}`;
        return;
      }

      if (!selectedUnit || selectedUnit.actionsLeft <= 0) return;

      const selectedPos = findUnitPosition(selectedUnit);
      if (!selectedPos) return;

      const dist = Math.abs(selectedPos.r - r) + Math.abs(selectedPos.c - c);

      if (specialModeActive === 'lay_bomb') {
        if (dist === 1 && !clickedUnit) {
          playerHasActiveBomb = true;
          playerPlacedBombCoords = { r, c };
          specialModeActive = null;
          selectedUnit.actionsLeft--;
          playBeep(900, 'square', 0.2);
          document.getElementById('arena-status').innerText = `${selectedUnit.name} laid an active bomb!`;
          if (selectedUnit.actionsLeft <= 0) selectedUnit = null;
          renderGridBoard();
          checkTurnCompletion();
        } else {
          alert("Bombs can only be placed on an adjacent empty cell!");
        }
        return;
      }

      if (specialModeActive === 'throw_target') {
        if (!unitToThrow) {
          let occupantInBase = clickedUnit && clickedUnit.baseActiveTurns > 0;
          if (clickedUnit && !clickedUnit.isPlayer && !clickedUnit.completelyInvisible && !occupantInBase && dist === 1) {
            unitToThrow = { unit: clickedUnit, r, c };
            titanPosRef = selectedPos;
            enemyTitanThrowsLeft--;
            playBeep(800, 'sine', 0.3);
            document.getElementById('arena-status').innerText = `Titan twirls ${clickedUnit.name}! Click target destination.`;
            
            gridBoardState[r][c] = null;
            setTimeout(() => {
              const titanCellEl = document.querySelector(`[data-row='${selectedPos.r}'][data-col='${selectedPos.c}']`);
              if (titanCellEl) {
                const victimEl = document.createElement('div');
                victimEl.className = 'grid-unit enemy twirling-victim';
                victimEl.style.position = 'absolute';
                victimEl.innerHTML = `<img src="${clickedUnit.photoUrl}" alt="${clickedUnit.name}">`;
                titanCellEl.appendChild(victimEl);
              }
            }, 50);
            renderGridBoard();
          }
        } else {
          if (!clickedUnit) {
            specialModeActive = null;
            playBeep(500, 'sawtooth', 0.8);
            document.getElementById('arena-status').innerText = `Throwing across the sky...`;

            gridBoardState[r][c] = unitToThrow.unit;
            renderGridBoard();

            setTimeout(() => {
              const targetCellEl = document.querySelector(`[data-row='${r}'][data-col='${c}'] .grid-unit`);
              if (targetCellEl) targetCellEl.classList.add('slow-mo-soaring');
            }, 50);

            setTimeout(() => {
              spawnDamagePopup(r, c, "SOAR IMPACT! -35");
              unitToThrow.unit.hp = Math.max(0, unitToThrow.unit.hp - 35);
              if (unitToThrow.unit.hp <= 0) {
                gridBoardState[r][c] = null;
                arenaGameCoins++; 
                updateCoinsDisplay();
                document.getElementById('arena-status').innerText = `1 less enemy to destroy`;
              }

              selectedUnit.actionsLeft--;
              unitToThrow = null;
              titanPosRef = null;
              if (selectedUnit.actionsLeft <= 0) selectedUnit = null;

              renderGridBoard();
              updateBattleHUD();
              checkBattleStatus();
            }, 2200);
          }
        }
        return;
      }

      let targetInBase = clickedUnit && clickedUnit.baseActiveTurns > 0;
      if (dist <= 1 && clickedUnit && !clickedUnit.isPlayer && !clickedUnit.completelyInvisible && !targetInBase) {
        let baseDmg = selectedUnit.power;
        if (selectedUnit.powerObj.type === 'speed') baseDmg = 4;
        let damage = baseDmg + Math.floor(Math.random() * 6) - 3;
        
        clickedUnit.hp = Math.max(0, clickedUnit.hp - damage);
        playBeep(700, 'square', 0.15);
        spawnDamagePopup(r, c, `-${damage}`);
        
        selectedUnit.actionsLeft--;
        if (clickedUnit.hp <= 0) {
          gridBoardState[r][c] = null;
          arenaGameCoins++; 
          updateCoinsDisplay();
          document.getElementById('arena-status').innerText = `1 less enemy to destroy`;
        }
        if (selectedUnit.actionsLeft <= 0) selectedUnit = null;

        renderGridBoard();
        updateBattleHUD();
        checkBattleStatus();
      } else {
        if (selectedUnit.baseActiveTurns > 0) {
          alert("This unit is stuck in their base and cannot move out for two turns!");
          return;
        }

        let maxMove = selectedUnit.powerObj.type === 'speed' ? 4 : 1;
        if (dist <= maxMove && !clickedUnit) {
          if (selectedUnit.powerObj.type === 'speed') {
            playBeep(1200, 'sine', 0.2);
            const startCellEl = document.querySelector(`[data-row='${selectedPos.r}'][data-col='${selectedPos.c}'] .grid-unit`);
            if (startCellEl) startCellEl.classList.add('speed-blur');
          } else {
            playBeep(300, 'sine', 0.1);
          }

          setTimeout(() => {
            gridBoardState[selectedPos.r][selectedPos.c] = null;
            gridBoardState[r][c] = selectedUnit;
            selectedUnit.actionsLeft--;

            if (enemyPlacedBomb && enemyPlacedBomb.r === r && enemyPlacedBomb.c === c) {
              playBeep(200, 'sawtooth', 0.6);
              spawnDamagePopup(r, c, "BOOM! UNIT LOST");

              const targetCell = document.querySelector(`[data-row='${r}'][data-col='${c}']`);
              if (targetCell) targetCell.classList.add('fiery-explosion');

              const unitEl = document.querySelector(`[data-row='${r}'][data-col='${c}'] .grid-unit`);
              if (unitEl) unitEl.classList.add('fading-red-powerloss');

              setTimeout(() => {
                selectedUnit.hp = 0;
                gridBoardState[r][c] = null;
                enemyPlacedBomb = null;
                document.getElementById('arena-status').innerText = `Your unit stepped on a hidden enemy bomb, faded red, lost power, and died!`;
                renderGridBoard();
                checkBattleStatus();
              }, 2500);

              return;
            }

            if (selectedUnit.actionsLeft <= 0) selectedUnit = null;

            renderGridBoard();
            checkTurnCompletion();
          }, selectedUnit.powerObj.type === 'speed' ? 350 : 0);
        }
      }
    }

    function spawnDamagePopup(r, c, text) {
      const board = document.getElementById('grid-board');
      const popup = document.createElement('div');
      popup.className = 'damage-popup';
      popup.innerText = text;
      const leftPct = ((c + 0.5) / GRID_COLS) * 100;
      const topPct = ((r + 0.5) / GRID_ROWS) * 100;
      popup.style.left = `${leftPct}%`;
      popup.style.top = `${topPct}%`;
      board.appendChild(popup);
      setTimeout(() => popup.remove(), 800);
    }

    function checkTurnCompletion() {
      const livingPlayerUnits = playerBattleUnits.filter(u => u.hp > 0);
      const allDone = livingPlayerUnits.every(u => u.actionsLeft <= 0);

      if (allDone && livingPlayerUnits.length > 0) {
        isPlayerTurn = false;
        selectedUnit = null;
        specialModeActive = null;
        document.getElementById('turn-indicator').innerText = "Villain Turn...";
        
        playerBattleUnits.forEach(u => {
          if (u.baseActiveTurns > 0) {
            u.baseActiveTurns--;
            u.hp = Math.min(u.maxHp, u.hp + Math.ceil(u.maxHp * 0.3));
          }
        });

        renderGridBoard();
        setTimeout(executeEnemyTurn, 1000);
      } else {
        checkBattleStatus();
      }
    }

    function executeEnemyTurn() {
      enemyBattleUnits.forEach(e => { if (e.hp > 0) e.actionsLeft = 2; });

      enemyBattleUnits.forEach(e => {
        if (e.invisibleTurnsLeft > 0) e.invisibleTurnsLeft--;
        if (e.invisibleTurnsLeft === 0) {
          e.fadingSlowly = false;
          e.completelyInvisible = false;
        }
      });
      playerBattleUnits.forEach(u => {
        if (u.invisibleTurnsLeft > 0) u.invisibleTurnsLeft--;
        if (u.invisibleTurnsLeft === 0) {
          u.fadingSlowly = false;
          u.completelyInvisible = false;
        }
      });

      if (!enemyPlacedBomb && Math.random() < 0.6) {
        const activeEnemies = enemyBattleUnits.filter(e => e.hp > 0);
        if (activeEnemies.length > 0) {
          const bomberEnemy = activeEnemies[Math.floor(Math.random() * activeEnemies.length)];
          const ePos = findUnitPosition(bomberEnemy);
          if (ePos && ePos.c > 0) {
            enemyPlacedBomb = { r: ePos.r, c: ePos.c - 1 };
          }
        }
      }

      if (!enemyBaseBuilt) {
        const activeEnemies = enemyBattleUnits.filter(e => e.hp > 0);
        if (activeEnemies.length > 0) {
          const builderEnemy = activeEnemies[Math.floor(Math.random() * activeEnemies.length)];
          const ePos = findUnitPosition(builderEnemy);
          if (ePos) {
            enemyBaseBuilt = true;
            builderEnemy.baseActiveTurns = 2;
            builderEnemy.hasBaseTile = { r: ePos.r, c: ePos.c };
            builderEnemy.hp = builderEnemy.maxHp;
          }
        }
      }

      enemyBattleUnits.forEach(e => {
        if (e.baseActiveTurns > 0) {
          e.baseActiveTurns--;
          e.hp = Math.min(e.maxHp, e.hp + Math.ceil(e.maxHp * 0.3));
        }
      });

      enemyBattleUnits.forEach(enemy => {
        if (enemy.hp <= 0) return;

        while (enemy.actionsLeft > 0) {
          const ePos = findUnitPosition(enemy);
          if (!ePos) break;

          if (enemy.bossType === 'invisible' && enemy.invisibleTurnsLeft === 0 && enemy.enemyInvisUsesLeft > 0 && Math.random() < 0.8) {
            playShhSound();
            enemy.enemyInvisUsesLeft--;
            enemy.invisibleTurnsLeft = 3;
            enemy.completelyInvisible = true;
            enemy.actionsLeft--;
            continue;
          }

          let targetPlayer = null, targetPR = -1, targetPC = -1;
          let minDistance = Infinity;

          for (let r = 0; r < GRID_ROWS; r++) {
            for (let c = 0; c < GRID_COLS; c++) {
              const unit = gridBoardState[r][c];
              if (unit && unit.isPlayer && unit.baseActiveTurns === 0) {
                const d = Math.abs(ePos.r - r) + Math.abs(ePos.c - c);
                if (d < minDistance) {
                  minDistance = d;
                  targetPlayer = unit;
                  targetPR = r;
                  targetPC = c;
                }
              }
            }
          }

          if (targetPlayer && minDistance <= 1) {
            let dmg = enemy.power + Math.floor(Math.random() * 6) - 3;
            targetPlayer.hp = Math.max(0, targetPlayer.hp - dmg);
            playBeep(200, 'sawtooth', 0.15);
            spawnDamagePopup(targetPR, targetPC, `-${dmg}`);
            if (targetPlayer.hp <= 0) {
              gridBoardState[targetPR][targetPC] = null;
              document.getElementById('arena-status').innerText = `1 less unit to destroy (you lost a unit)`;
            }
            enemy.actionsLeft--;
          } else if (targetPlayer) {
            if (enemy.baseActiveTurns > 0) {
              enemy.actionsLeft--;
              continue;
            }

            let dr = Math.sign(targetPR - ePos.r);
            let dc = Math.sign(targetPC - ePos.c);
            
            let nextR = ePos.r;
            let nextC = ePos.c;
            if (Math.abs(targetPR - ePos.r) >= Math.abs(targetPC - ePos.c)) {
              nextR += dr;
            } else {
              nextC += dc;
            }

            if (nextR >= 0 && nextR < GRID_ROWS && nextC >= 0 && nextC < GRID_COLS && !gridBoardState[nextR][nextC]) {
              gridBoardState[ePos.r][ePos.c] = null;
              gridBoardState[nextR][nextC] = enemy;

              if (playerHasActiveBomb && playerPlacedBombCoords && playerPlacedBombCoords.r === nextR && playerPlacedBombCoords.c === nextC) {
                playBeep(250, 'square', 0.5);
                spawnDamagePopup(nextR, nextC, "BOOM! ZAPPED!");

                const targetCell = document.querySelector(`[data-row='${nextR}'][data-col='${nextC}']`);
                if (targetCell) targetCell.classList.add('zappy-explosion');

                const unitEl = document.querySelector(`[data-row='${nextR}'][data-col='${nextC}'] .grid-unit`);
                if (unitEl) unitEl.classList.add('zappy-victim');

                setTimeout(() => {
                  enemy.hp = 0;
                  gridBoardState[nextR][nextC] = null;
                  playerHasActiveBomb = false;
                  playerPlacedBombCoords = null;
                  arenaGameCoins++;
                  updateCoinsDisplay();
                  document.getElementById('arena-status').innerText = `An enemy unit walked on your bomb, became red and zappy, and disappeared!`;
                  renderGridBoard();
                  checkBattleStatus();
                }, 1800);

                enemy.actionsLeft = 0;
                continue;
              }
            } else {
              let fallbackC = ePos.c - 1;
              if (fallbackC >= 0 && fallbackC < GRID_COLS && !gridBoardState[ePos.r][fallbackC]) {
                gridBoardState[ePos.r][ePos.c] = null;
                gridBoardState[ePos.r][fallbackC] = enemy;
              }
            }
            enemy.actionsLeft--;
          } else {
            enemy.actionsLeft--;
          }
        }
      });

      playerBattleUnits.forEach(u => { if (u.hp > 0) u.actionsLeft = 2; });

      isPlayerTurn = true;
      document.getElementById('turn-indicator').innerText = "Your Turn";
      renderGridBoard();
      updateBattleHUD();
      checkBattleStatus();
    }

    function updateBattleHUD() {
      const alivePlayers = playerBattleUnits.filter(u => u.hp > 0).length;
      const aliveEnemies = enemyBattleUnits.filter(u => u.hp > 0).length;
      document.getElementById('player-alive-count').innerText = alivePlayers;
      document.getElementById('enemy-alive-count').innerText = aliveEnemies;
    }

    function checkBattleStatus() {
      const alivePlayers = playerBattleUnits.filter(u => u.hp > 0).length;
      const aliveEnemies = enemyBattleUnits.filter(u => u.hp > 0).length;

      updateBattleHUD();

      if (aliveEnemies === 0) {
        playerScore += 8;
        userCoins += 500; 
        updateCoinsDisplay();

        if (activeSquadTier === 'easy') {
          playVictoryMelody();
          document.getElementById('victory-modal-title').innerText = "🌟 AWESOME VICTORY! 🌟";
          document.getElementById('victory-reward-text').innerText = `Incredible triumph on Easy Tier! You crushed the enemy squad with awesome style! +8 score and +500 coins!`;
        } else {
          playBeep(880, 'sine', 0.4);
          document.getElementById('victory-modal-title').innerText = "Victory";
          document.getElementById('victory-reward-text').innerText = `Victory! +8 score and +500 coins!`;
        }

        document.getElementById('victory-modal').classList.add('show');
        isPlayerTurn = false;
      } else if (alivePlayers === 0) {
        playBeep(150, 'sawtooth', 0.4);
        
        playerScore = Math.max(0, playerScore - 8);
        updateCoinsDisplay();

        document.getElementById('game-over-modal').classList.add('show');
        isPlayerTurn = false;
      }
    }

    function returnHomeFromModal() {
      document.getElementById('game-over-modal').classList.remove('show');
      document.getElementById('victory-modal').classList.remove('show');
      resetArena();
      switchMainTab('shop');
    }

    function returnToShopFromArena() {
      resetArena();
      switchMainTab('shop');
    }

    function resetArena() {
      document.getElementById('arena-select-step').style.display = 'block';
      document.getElementById('arena-squad-step').style.display = 'none';
      document.getElementById('arena-fight-step').style.display = 'none';
      specialModeActive = null;
      unitToThrow = null;
      arenaGameCoins = 0;
    }

    function handleKeyPress(e) {
      if (e.key === 'Enter') {
        sendChatMessage();
      }
    }

    function sendChatMessage() {
      const input = document.getElementById('chat-msg-input');
      const text = input.value.trim();
      if (!text) return;
      playBeep(500, 'sine', 0.1);

      const chatBox = document.getElementById('chat-box');
      const msgSelf = document.createElement('div');
      msgSelf.className = 'chat-message self';
      msgSelf.innerText = text;
      chatBox.appendChild(msgSelf);
      input.value = '';
      chatBox.scrollTop = chatBox.scrollHeight;

      setTimeout(() => {
        const target = document.getElementById('chat-target').value;
        const msgAI = document.createElement('div');
        msgAI.className = 'chat-message';
        msgAI.innerHTML = `<strong>${target}:</strong> Roster units are fully prepped and operational for the tactical arena!`;
        chatBox.appendChild(msgAI);
        chatBox.scrollTop = chatBox.scrollHeight;
      }, 600);
    }
  </script>
</body>
