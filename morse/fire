<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cyber Nexus Tactical Grid Arena - Enhanced Edition</title>
  <style>
    :root {
      --bg-dark: #020610;
      --bg-gradient: radial-gradient(circle at 50% 10%, #3b0764 0%, #020610 70%);
      --card-bg: rgba(10, 15, 30, 0.9);
      --neon-gold: #fde047;
      --neon-cyan: #06b6d4;
      --neon-pink: #ec4899;
      --neon-purple: #d8b4fe;
      --neon-red: #f43f5e;
      --neon-green: #34d399;
      --text-main: #ffffff;
      --glass-border: rgba(6, 182, 212, 0.6);
    }

    * {
      box-sizing: border-box;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      user-select: none;
    }

    body {
      background: var(--bg-dark);
      background-image: var(--bg-gradient);
      color: var(--text-main);
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
    }

    #auth-page {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(2, 6, 16, 0.98);
      backdrop-filter: blur(20px);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }

    .auth-container {
      background: rgba(15, 23, 42, 0.95);
      border: 2px solid var(--neon-cyan);
      border-radius: 24px;
      padding: 40px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      box-shadow: 0 25px 70px rgba(0, 0, 0, 0.9), 0 0 45px rgba(6, 182, 212, 0.5), inset 0 0 20px rgba(6, 182, 212, 0.2);
      max-width: 480px;
      width: 90%;
      text-align: center;
    }

    .auth-container h2 {
      font-size: 2rem;
      margin: 0;
      color: #fff;
      text-shadow: 0 0 25px rgba(6, 182, 212, 1), 0 0 10px rgba(236, 72, 153, 0.8);
      text-transform: uppercase;
    }

    .auth-btn {
      background: linear-gradient(135deg, var(--neon-cyan), #0284c7);
      color: #020610;
      border: none;
      padding: 14px 28px;
      font-size: 1rem;
      font-weight: 900;
      border-radius: 12px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 1px;
      width: 100%;
      box-shadow: 0 0 25px rgba(6, 182, 212, 0.7);
      transition: all 0.25s;
    }

    .auth-btn:hover {
      box-shadow: 0 0 35px rgba(6, 182, 212, 1);
      transform: translateY(-2px);
    }

    .auth-input-group {
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: 100%;
      margin-top: 10px;
    }

    .auth-input-group input {
      padding: 14px;
      border-radius: 10px;
      border: 1px solid var(--neon-cyan);
      background: rgba(15, 23, 42, 0.9);
      color: #fff;
      font-size: 1rem;
      outline: none;
      text-align: center;
      box-shadow: inset 0 0 12px rgba(6, 182, 212, 0.4), 0 0 10px rgba(6, 182, 212, 0.2);
    }

    .tiny-home-btn {
      position: fixed;
      top: 15px;
      left: 15px;
      background: rgba(15, 23, 42, 0.85);
      color: var(--text-main);
      border: 1px solid var(--glass-border);
      padding: 4px 10px;
      font-size: 0.7rem;
      font-weight: 700;
      border-radius: 6px;
      cursor: pointer;
      z-index: 1000;
      text-transform: uppercase;
      backdrop-filter: blur(8px);
      box-shadow: 0 0 10px rgba(6, 182, 212, 0.3);
      transition: all 0.2s;
    }

    .tiny-home-btn:hover {
      background: rgba(6, 182, 212, 0.3);
      border-color: var(--neon-cyan);
    }

    header {
      text-align: center;
      margin-bottom: 12px;
    }

    h1 {
      font-size: 2.2rem;
      margin: 0;
      color: #fff;
      text-shadow: 0 0 25px rgba(6, 182, 212, 0.8), 0 0 10px rgba(236, 72, 153, 0.6);
      letter-spacing: 3px;
      text-transform: uppercase;
      font-weight: 900;
    }

    .header-info-bar {
      display: flex;
      gap: 15px;
      justify-content: center;
      align-items: center;
      margin-top: 10px;
    }

    .badge-display {
      background: rgba(15, 23, 42, 0.95);
      border: 1px solid var(--neon-gold);
      box-shadow: 0 0 20px rgba(253, 224, 71, 0.4);
      padding: 6px 16px;
      border-radius: 30px;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--neon-gold);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      backdrop-filter: blur(8px);
    }

    .top-nav {
      display: flex;
      gap: 12px;
      margin: 15px 0;
    }

    .nav-btn {
      background: rgba(15, 23, 42, 0.85);
      color: var(--text-main);
      border: 1px solid var(--glass-border);
      padding: 8px 18px;
      font-size: 0.9rem;
      font-weight: 700;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      backdrop-filter: blur(10px);
    }

    .nav-btn:hover {
      background: rgba(6, 182, 212, 0.25);
      border-color: var(--neon-cyan);
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.6);
      transform: translateY(-1px);
    }

    .nav-btn.active {
      background: linear-gradient(135deg, rgba(6, 182, 212, 0.4), rgba(216, 180, 254, 0.4));
      border-color: var(--neon-cyan);
      color: #fff;
      box-shadow: 0 0 25px rgba(6, 182, 212, 0.7);
    }

    .container {
      width: 100%;
      max-width: 960px;
      background: var(--card-bg);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), inset 0 0 25px rgba(6, 182, 212, 0.15);
      backdrop-filter: blur(16px);
      position: relative;
      overflow: hidden;
    }

    .view-panel {
      display: none;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .view-panel.active {
      display: flex;
    }

    .category-nav {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }

    .cat-btn {
      flex: 1;
      min-width: 120px;
      padding: 10px;
      font-size: 0.9rem;
      font-weight: 700;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      background: rgba(15, 23, 42, 0.7);
      color: #94a3b8;
      cursor: pointer;
      transition: all 0.2s ease;
      text-transform: uppercase;
      backdrop-filter: blur(6px);
    }

    .cat-btn.easy.active { border-color: var(--neon-cyan); color: #fff; background: rgba(6, 182, 212, 0.25); box-shadow: 0 0 20px rgba(6, 182, 212, 0.4); }
    .cat-btn.medium.active { border-color: var(--neon-gold); color: #fff; background: rgba(253, 224, 71, 0.25); box-shadow: 0 0 20px rgba(253, 224, 71, 0.4); }
    .cat-btn.hard.active { border-color: var(--neon-pink); color: #fff; background: rgba(236, 72, 153, 0.25); box-shadow: 0 0 20px rgba(236, 72, 153, 0.4); }
    .cat-btn.legendary.active { border-color: var(--neon-purple); color: #fff; background: rgba(216, 180, 254, 0.25); box-shadow: 0 0 20px rgba(216, 180, 254, 0.4); }

    .shop-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 16px;
      width: 100%;
      max-height: 440px;
      overflow-y: auto;
      padding-right: 4px;
    }

    .fighter-card {
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      position: relative;
      transition: all 0.25s ease;
      backdrop-filter: blur(8px);
    }

    .fighter-card:hover {
      transform: translateY(-4px);
      border-color: var(--neon-cyan);
      box-shadow: 0 10px 30px rgba(6, 182, 212, 0.3);
    }

    .fighter-card .avatar-box {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      overflow: hidden;
      border: 2px solid var(--neon-cyan);
      box-shadow: 0 0 15px rgba(6, 182, 212, 0.5);
      background: #000;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .fighter-card .avatar-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .fighter-card .title {
      font-size: 1rem;
      font-weight: 800;
      color: #fff;
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
    }

    .fighter-card .stats {
      font-size: 0.8rem;
      color: #cbd5e1;
      display: flex;
      flex-direction: column;
      gap: 3px;
      text-align: left;
      width: 100%;
    }

    .fighter-card .superpower-desc {
      font-size: 0.75rem;
      color: var(--neon-gold);
      background: rgba(253, 224, 71, 0.1);
      border: 1px dashed rgba(253, 224, 71, 0.4);
      padding: 6px 8px;
      border-radius: 8px;
      width: 100%;
      text-align: left;
    }

    .buy-btn {
      width: 100%;
      padding: 9px;
      border-radius: 8px;
      border: none;
      font-weight: 800;
      font-size: 0.85rem;
      cursor: pointer;
      text-transform: uppercase;
      background: var(--neon-gold);
      color: #020610;
      transition: all 0.2s;
      box-shadow: 0 0 20px rgba(253, 224, 71, 0.5);
    }

    .buy-btn:hover {
      box-shadow: 0 0 30px rgba(253, 224, 71, 0.8);
      transform: scale(1.02);
    }

    .buy-btn.owned {
      background: rgba(52, 211, 153, 0.25);
      border: 1px solid var(--neon-green);
      color: var(--neon-green);
      box-shadow: none;
      cursor: default;
    }

    .squad-select-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 12px;
      width: 100%;
      max-height: 340px;
      overflow-y: auto;
      margin: 15px 0;
      padding: 4px;
    }

    .select-unit-card {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .select-unit-card.selected-squad {
      border-color: var(--neon-gold);
      box-shadow: 0 0 25px rgba(253, 224, 71, 0.4);
      background: rgba(253, 224, 71, 0.15);
    }

    .arena-hud {
      display: flex;
      justify-content: space-between;
      width: 100%;
      align-items: center;
      gap: 15px;
      margin-bottom: 12px;
      font-size: 0.9rem;
      background: rgba(15, 23, 42, 0.7);
      padding: 8px 16px;
      border-radius: 12px;
      border: 1px solid rgba(6, 182, 212, 0.3);
      box-shadow: 0 0 15px rgba(6, 182, 212, 0.15);
    }

    .tactical-grid-container {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      position: relative;
    }

    .grid-board {
      display: grid;
      gap: 8px;
      background: rgba(5, 10, 25, 0.9);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      padding: 12px;
      width: 100%;
      max-width: 780px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7), inset 0 0 30px rgba(6, 182, 212, 0.1);
      position: relative;
    }

    .grid-cell {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      aspect-ratio: 1 / 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      position: relative;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .grid-cell:hover {
      border-color: rgba(6, 182, 212, 0.8);
      background: rgba(6, 182, 212, 0.15);
      box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
    }

    .grid-cell.has-base {
      background: radial-gradient(circle, rgba(52, 211, 153, 0.4) 0%, rgba(6, 182, 212, 0.4) 100%);
      border: 2px dashed var(--neon-green);
      box-shadow: 0 0 20px rgba(52, 211, 153, 0.6), inset 0 0 15px var(--neon-cyan);
    }
    
    .grid-cell.has-base::after {
      content: '⚡';
      position: absolute;
      font-size: 0.8rem;
      top: 2px;
      left: 2px;
      animation: pulseBase 1.5s infinite alternate;
    }

    .grid-cell.has-player-bomb::before {
      content: '💣';
      position: absolute;
      font-size: 0.9rem;
      bottom: 2px;
      right: 2px;
      z-index: 5;
      animation: pulseBomb 1s infinite alternate;
    }

    .grid-cell.fiery-explosion {
      background: radial-gradient(circle, #ff4500 0%, #ff8c00 50%, #ff0000 100%) !important;
      border-color: #ff4500 !important;
      box-shadow: 0 0 35px #ff4500, inset 0 0 25px #ffff00 !important;
      animation: fieryPulse 0.5s infinite alternate;
    }

    @keyframes fieryPulse {
      0% { transform: scale(1); filter: brightness(1); }
      100% { transform: scale(1.05); filter: brightness(1.4); }
    }

    .grid-cell.zappy-explosion {
      background: radial-gradient(circle, #00ffff 0%, #3b82f6 50%, #9333ea 100%) !important;
      border-color: var(--neon-cyan) !important;
      box-shadow: 0 0 35px var(--neon-cyan), inset 0 0 25px #ffffff !important;
      animation: zappyFlash 0.3s infinite alternate;
    }

    @keyframes zappyFlash {
      0% { transform: scale(1); filter: hue-rotate(0deg); }
      100% { transform: scale(1.05); filter: hue-rotate(90deg) brightness(1.5); }
    }

    @keyframes pulseBomb {
      0% { transform: scale(0.9); opacity: 0.7; }
      100% { transform: scale(1.2); opacity: 1; }
    }

    @keyframes pulseBase {
      0% { transform: scale(0.9); opacity: 0.7; }
      100% { transform: scale(1.1); opacity: 1; }
    }

    .grid-cell.highlight-move {
      border-color: var(--neon-gold);
      background: rgba(253, 224, 71, 0.2);
      box-shadow: inset 0 0 20px rgba(253, 224, 71, 0.3);
    }

    .grid-cell.highlight-attack {
      border-color: var(--neon-red);
      background: rgba(244, 63, 94, 0.25);
      box-shadow: inset 0 0 20px rgba(244, 63, 94, 0.3);
    }

    .grid-cell.highlight-throw {
      border-color: var(--neon-purple);
      background: rgba(216, 180, 254, 0.25);
      box-shadow: inset 0 0 20px rgba(216, 180, 254, 0.4);
    }

    .grid-cell.highlight-bomb {
      border-color: var(--neon-pink);
      background: rgba(236, 72, 153, 0.3);
      box-shadow: inset 0 0 20px rgba(236, 72, 153, 0.5);
    }

    .grid-unit {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      overflow: hidden;
      border: 2px solid #fff;
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.6);
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      background: #000;
      transition: transform 0.25s ease, opacity 2.5s ease-in-out, filter 2.5s ease-in-out;
    }

    .grid-unit img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .grid-unit.player {
      border-color: var(--neon-cyan);
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.7);
    }

    .grid-unit.enemy {
      border-color: var(--neon-pink);
      box-shadow: 0 0 20px rgba(236, 72, 153, 0.7);
    }

    .grid-unit.selected {
      transform: scale(1.15);
      box-shadow: 0 0 30px var(--neon-gold), 0 0 15px #fff;
      border-color: var(--neon-gold);
    }

    .grid-unit.completely-invisible {
      opacity: 0 !important;
      pointer-events: none !important;
      filter: blur(5px);
      transition: opacity 0.5s ease-in-out, filter 0.5s ease-in-out !important;
    }

    .grid-unit.fading-red-powerloss {
      opacity: 0 !important;
      filter: drop-shadow(0 0 25px #ff4500) sepia(100%) saturate(500%) hue-rotate(-30deg) brightness(1.5) blur(3px) !important;
      transform: scale(0.2) rotate(360deg);
      transition: opacity 2.5s ease-in-out, filter 2.5s ease-in-out, transform 2.5s ease-in-out !important;
    }

    .grid-unit.zappy-victim {
      opacity: 0 !important;
      filter: drop-shadow(0 0 30px #00ffff) invert(80%) sepia(100%) saturate(800%) hue-rotate(140deg) brightness(2) blur(4px) !important;
      transform: scale(0.1) skewX(45deg) rotate(720deg);
      transition: opacity 1.8s ease-in-out, filter 1.8s ease-in-out, transform 1.8s ease-in-out !important;
    }

    .grid-unit.fading-slowly {
      opacity: 0.35 !important;
      filter: blur(1.5px) grayscale(60%);
      transition: opacity 2.5s ease-in-out, filter 2.5s ease-in-out !important;
    }

    .grid-unit.speed-blur {
      transform: scale(0.6) skewX(-25deg);
      filter: blur(3px) brightness(1.8);
      box-shadow: 0 0 25px var(--neon-cyan);
    }

    .grid-unit.twirling-victim {
      animation: twirlAroundTitan 0.8s linear infinite;
      z-index: 50;
      box-shadow: 0 0 25px var(--neon-purple);
    }

    @keyframes twirlAroundTitan {
      0% { transform: translate(0, -15px) scale(0.9) rotate(0deg); }
      25% { transform: translate(15px, 0) scale(0.9) rotate(90deg); }
      50% { transform: translate(0, 15px) scale(0.9) rotate(180deg); }
      75% { transform: translate(-15px, 0) scale(0.9) rotate(270deg); }
      100% { transform: translate(0, -15px) scale(0.9) rotate(360deg); }
    }

    .grid-unit.slow-mo-soaring {
      transition: all 2.2s cubic-bezier(0.25, 1, 0.5, 1) !important;
      transform: scale(1.4) rotate(1080deg);
      z-index: 100;
      filter: drop-shadow(0 0 25px var(--neon-gold)) brightness(1.5);
    }

    .unit-badge {
      position: absolute;
      top: -6px;
      right: -6px;
      background: var(--neon-purple);
      color: #020610;
      font-size: 0.55rem;
      font-weight: 900;
      padding: 1px 4px;
      border-radius: 50%;
      border: 1px solid #fff;
      z-index: 10;
    }

    .unit-hp-pip {
      position: absolute;
      bottom: -8px;
      background: rgba(2, 6, 16, 0.95);
      color: var(--neon-gold);
      font-size: 0.55rem;
      font-weight: 900;
      padding: 1px 4px;
      border-radius: 4px;
      border: 1px solid rgba(253, 224, 71, 0.4);
      white-space: nowrap;
      z-index: 10;
    }

    .battle-controls {
      display: flex;
      gap: 10px;
      width: 100%;
      justify-content: center;
      margin-top: 10px;
      flex-wrap: wrap;
    }

    .action-btn {
      background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      color: #fff;
      border: 1px solid var(--neon-cyan);
      padding: 10px 18px;
      font-size: 0.9rem;
      font-weight: 800;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.3);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .action-btn:hover {
      border-color: var(--neon-gold);
      color: var(--neon-gold);
      box-shadow: 0 0 25px rgba(253, 224, 71, 0.6);
      transform: translateY(-2px);
    }

    .action-btn.primary {
      background: linear-gradient(135deg, #0891b2, #0e7490);
      border-color: var(--neon-cyan);
    }

    .action-btn.danger {
      background: linear-gradient(135deg, #e11d48, #9f1239);
      border-color: var(--neon-pink);
    }

    .action-btn.special {
      background: linear-gradient(135deg, #8b5cf6, #6d28d9);
      border-color: var(--neon-purple);
    }

    .btn-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 14px;
      width: 100%;
      margin-top: 15px;
    }

    .damage-popup {
      position: absolute;
      font-size: 1.4rem;
      font-weight: 900;
      color: var(--neon-gold);
      text-shadow: 0 0 15px var(--neon-pink), 2px 2px 0 #000;
      pointer-events: none;
      animation: floatUp 0.8s ease-out forwards;
      z-index: 120;
    }

    @keyframes floatUp {
      0% { opacity: 1; transform: translateY(0) scale(0.8); }
      100% { opacity: 0; transform: translateY(-40px) scale(1.2); }
    }

    .back-btn {
      background: rgba(51, 65, 85, 0.9);
      margin-top: 12px;
      padding: 10px 22px;
      font-size: 0.9rem;
      width: fit-content;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 10px;
      color: #fff;
      cursor: pointer;
      font-weight: 800;
      text-transform: uppercase;
      transition: all 0.2s;
      box-shadow: 0 0 15px rgba(255, 255, 255, 0.1);
    }

    .back-btn:hover {
      background: rgba(100, 116, 139, 0.9);
      box-shadow: 0 0 25px rgba(255, 255, 255, 0.3);
    }

    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(2, 6, 16, 0.9);
