        if (happiness >= 80) {
            this.tier = 3;
            this.creditUpkeep = 300;
            this.scienceUpkeep = 40;
            this.efficiencyMultiplier = 1.5;
            this.unlockedTerraformers = ["Small Scout-Terraformer", "Medium Regional-Terraformer", "Heavy Mega-Terraformer"];
