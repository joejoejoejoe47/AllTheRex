// --- GLOBAL WALLET STATE ---
let playerWallet = {
    credits: 5000,
    science: 100,
    terraformLevel: 0, // Out of 100%
};

// --- EMPIRE BUILDINGS & UPKEEP STATS ---
let infrastructure = {
    cities: 2,
    commercialMarkets: 2, // Generates Credits
    campuses: 1,          // Generates Science
    companies: 1          // Consumes Credits & Science to run
};

// Rates per tick
const CREDIT_GENERATION_RATE = 150; // Per Commercial Market
const COMPANY_CREDIT_COST    = 80;  // Per Company
const SCIENCE_GENERATION_RATE = 20;  // Per Campus
const COMPANY_SCIENCE_COST   = 10;  // Per Company

// --- THE GLOBAL TICK ENGINE ---
const TICK_RATE_MS = 2000; // 2 Seconds (Can be adjusted to 3000ms)

function runGlobalTick() {
    console.log("--- GLOBAL TICK START ---");

    // 1. Calculate Income & Upkeep
    const totalIncome = infrastructure.commercialMarkets * CREDIT_GENERATION_RATE;
    const totalUpkeep = infrastructure.companies * COMPANY_CREDIT_COST;
    const netCredits  = totalIncome - totalUpkeep;

    // 2. Calculate Science
    const scienceGenerated = infrastructure.campuses * SCIENCE_GENERATION_RATE;
    const scienceConsumed  = infrastructure.companies * COMPANY_SCIENCE_COST;
    const netScience       = scienceGenerated - scienceConsumed;

    // 3. Apply changes to Global Wallet
    playerWallet.credits += netCredits;
    
    // Science cannot go below 0
    playerWallet.science = Math.max(0, playerWallet.science + netScience);

    // 4. Terraform Progress (Companies driving progress if funded)
    if (playerWallet.science > 0 && infrastructure.companies > 0) {
        // Companies use science to terraform Mars
        const progressIncrement = infrastructure.companies * 0.5; 
        playerWallet.terraformLevel = Math.min(100, playerWallet.terraformLevel + progressIncrement);
    }

    // --- REPORT STATE ---
    console.log(`Credits: ${playerWallet.credits} (${netCredits >= 0 ? '+' : ''}${netCredits}/tick)`);
    console.log(`Science: ${playerWallet.science} (${netScience >= 0 ? '+' : ''}${netScience}/tick)`);
    console.log(`Terraforming Progress: ${playerWallet.terraformLevel.toFixed(1)}%`);
    console.log("------------------------");
}

// Start the loop
setInterval(runGlobalTick, TICK_RATE_MS);
class MarsCity {
    constructor(name) {
        this.name = name;
        this.population = 500;
        this.happiness = 50.0; // Starts neutral at 50%
        this.tier = "Small Biosphere Dome";
        this.isSecuredByMilitary = true; // Secured state via defense troops
    }

    /**
     * Updates the city calculations on every global heartbeat tick
     * @param {string} resourceSupplyState - 'ABUNDANT', 'NORMAL', or 'STARVED'
     */
    updateTick(resourceSupplyState) {
        // 1. EVALUATE HAPPINESS MODIFIERS
        let happinessChange = 0;

        // Supply modifiers
        if (resourceSupplyState === 'ABUNDANT') happinessChange += 4.0;
        else if (resourceSupplyState === 'STARVED') happinessChange -= 8.0;

        // Security modifiers (alien threat presence)
        if (this.isSecuredByMilitary) {
            happinessChange += 2.0; 
        } else {
            // Unsecured territory breeds high anxiety among colonists
            happinessChange -= 10.0;
        }

        // Apply and clamp value between 0% and 100%
        this.happiness = Math.max(0, Math.min(100, this.happiness + happinessChange));

        // 2. SIMULATE POPULATION GROWTH
        // Population shifts follow the current happiness environment
        if (this.happiness > 70) {
            this.population += Math.floor(this.population * 0.04); // Growth acceleration
        } else if (this.happiness < 30) {
            this.population -= Math.floor(this.population * 0.05); // Emigration / losses
        }

        // 3. AUTO-EVOLUTION UPGRADE LOGIC
        this.evaluateTierUpgrades();
    }

    evaluateTierUpgrades() {
        const oldTier = this.tier;

        if (this.population >= 3500 && this.happiness >= 85) {
            this.tier = "Skyscraper Megastructure Dome";
        } else if (this.population >= 1200 && this.happiness >= 70) {
            this.tier = "Medium Habitation Ring";
        } else if (this.population < 1000) {
            // Cities can downscale if population collapses
            this.tier = "Small Biosphere Dome";
        }

        if (this.tier !== oldTier) {
            console.log(`[EVOLUTION ALERT] ${this.name} has converted from a [${oldTier}] to a [${this.tier}]!`);
        }
    }

    /**
     * Determines how capable spawned corporations will be.
     * Happy cities spawn highly optimized parent firms.
     */
    getCompanyCapabilityMultiplier() {
        if (this.happiness >= 80) return 1.5; // +50% production output efficiency
        if (this.happiness <= 35) return 0.7; // -30% performance penalty
        return 1.0;
    }
}

