            this.scienceUpkeep = 15;
            this.efficiencyMultiplier = 1.1;
            this.unlockedTerraformers = ["Small Scout-Terraformer", "Medium Regional-Terraformer"];
        } 
        else {
            this.tier = 1;
            this.creditUpkeep = 50;
            this.scienceUpkeep = 0;
            this.efficiencyMultiplier = 0.75; // Low morale penalizes output speeds
