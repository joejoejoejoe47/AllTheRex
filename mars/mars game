class MarsGridTile {
    constructor(x, y) {
        this.x = x;
        this.y = y;
        this.isTerraformed = false; // The absolute spatial lock variable
        this.occupyingStructure = null; // Stores object state ('CITY_DOME', 'MILITARY_BASE', etc.)
    }
}

class MarsSectorMap {
    /**
     * @param {number} width - Horizontal tile limit
     * @param {number} height - Vertical tile limit
     */
    constructor(width, height) {
        this.width = width;
        this.height = height;
        this.grid = [];
        
        this.initializeEmptyGrid();
    }

    initializeEmptyGrid() {
        for (let x = 0; x < this.width; x++) {
            this.grid[x] = [];
            for (let y = 0; y < this.height; y++) {
                this.grid[x][y] = new MarsGridTile(x, y);
            }
        }
        // Baseline drop: Every player starts with a small cleared landing zone anchor
        this.grid[0][0].isTerraformed = true; 
    }

    /**
     * Centralized security filter handling placement legalities
     * @param {number} x 
     * @param {number} y 
     * @param {string} structureType - 'CITY_DOME' or 'MILITARY_BASE'
     * @returns {boolean}
     */
    canPlaceStructure(x, y, structureType) {
        const tile = this.grid[x][y];

        // 1. Check tile vacancy
        if (tile.occupyingStructure !== null) {
            console.error(`Placement blocked: Coordinate [${x},${y}] is already occupied.`);
            return false;
        }

        // 2. ENFORCE SPECIFIC TERRAFORMING LAW
        if (!tile.isTerraformed) {
            console.error(`Placement blocked: Coordinate [${x},${y}] is hazardous! Requires terraforming machine processing.`);
            return false;
        }

        // Sector is cleared and safe for colonial layout expansion
        return true;
    }

    executePlacement(x, y, structureType) {
        if (this.canPlaceStructure(x, y, structureType)) {
            this.grid[x][y].occupyingStructure = structureType;
            console.log(`[CONSTRUCTION SUCCESS] Placed ${structureType} at spatial coordinates [${x},${y}].`);
            return true;
        }
        return false;
    }

    /**
     * Invoked exclusively by active Terraforming Machines
     */
    completeTerraformSector(x, y) {
        this.grid[x][y].isTerraformed = true;
        console.log(`[TERRAIN ALERT] Coordinates [${x},${y}] have been rendered biochemically stable!`);
    }
}
class TerraformerMachine {
    /**
     * @param {string} sizeType - 'SMALL' or 'LARGE'
     * @param {number} centerX - The X grid anchor location
     * @param {number} centerY - The Y grid anchor location
     */
    constructor(sizeType, centerX, centerY) {
        this.sizeType = sizeType;
        this.centerX = centerX;
        this.centerY = centerY;
        
        this.progressPercent = 0;
        this.isComplete = false;

        // Configuration sets based on machine engineering scope
        if (sizeType === 'LARGE') {
            this.radius = 4;        // 4 tiles in every direction = 9x9 grid layout
            this.totalDurationSeconds = 90; 
        } else {
            this.radius = 1;        // 1 tile in every direction = 3x3 grid layout
            this.totalDurationSeconds = 30; 
        }
        
        this.secondsRemaining = this.totalDurationSeconds;
    }

    /**
     * Process tick executed every second by the core server engine
     * @param {boolean} isParentCompanyOperational - Output from player corporate solvency check
     * @param {MarsSectorMap} currentMapInstance - The live active game grid mapping
     */
    processSecondTick(isParentCompanyOperational, currentMapInstance) {
        if (this.isComplete) return;

        // CODE CONSTRAINT CHECK: Absolute validation rule checking business health
        if (!isParentCompanyOperational) {
            console.warn(`[MACHINE STALLED] Terraformer at [${this.centerX},${this.centerY}] is unpowered. Managing company lacks upkeep capital.`);
            return; // Exit sequence early without accumulating progress
        }

        // Advance processing counters
        this.secondsRemaining -= 1;
        this.progressPercent = ((this.totalDurationSeconds - this.secondsRemaining) / this.totalDurationSeconds) * 100;

        console.log(`[TERRAFORMING] Machine [${this.sizeType}] at [${this.centerX},${this.centerY}]: ${this.progressPercent.toFixed(1)}% complete.`);

        // Validation target evaluation
        if (this.secondsRemaining <= 0) {
            this.executeGridConversion(currentMapInstance);
        }
    }

    /**
     * Iterates through the calculation radius to permanently re-write the sector tiles
     * @param {MarsSectorMap} map 
     */
    executeGridConversion(map) {
        this.isComplete = true;
        this.progressPercent = 100;
        
        console.log(`[CONVERSION TRIGGERED] Atmospheric seal complete. Altering grid blocks...`);

        // Compute localized bounding box bounds based on radius settings
        const minX = Math.max(0, this.centerX - this.radius);
        const maxX = Math.min(map.width - 1, this.centerX + this.radius);
        const minY = Math.max(0, this.centerY - this.radius);
        const maxY = Math.min(map.height - 1, this.centerY + this.radius);

        // Convert all targeted cellular instances within the zone matrix
        for (let x = minX; x <= maxX; x++) {
            for (let y = minY; y <= maxY; y++) {
                map.completeTerraformSector(x, y); 
            }
        }
        
        console.log(`[SUCCESS] A ${this.sizeType === 'LARGE' ? '9x9' : '3x3'} area has been permanently converted.`);
    }
}
class ResourceDeposit {
    /**
     * @param {string} type - 'IRON' or 'TITANIUM'
     * @param {number} x - Horizontal coordinate location
     * @param {number} y - Vertical coordinate location
     * @param {number} initialRichness - Total amount available to mine
     */
    constructor(type, x, y, initialRichness = 500) {
        this.type = type; 
        this.x = x;
        this.y = y;
        this.richness = initialRichness;
        this.isDepleted = false;
        this.hasHarvester = false;
    }

    /**
     * Extracts a fixed volume of ore from the ground vector
     * @param {number} baseAmount - Standard extraction rate
     * @returns {number} Actual amount harvested
     */
    extractOre(baseAmount) {
        if (this.isDepleted) return 0;

        // Ensure we don't extract more than what remains in the vein
        const actualExtracted = Math.min(this.richness, baseAmount);
        this.richness -= actualExtracted;

        if (this.richness <= 0) {
            this.isDepleted = true;
            this.hasHarvester = false;
            console.log(`[RESOURCE DEPLETED] Mining node at [${this.x},${this.y}] has run completely dry!`);
        }

        return actualExtracted;
    }
}

class InventoryManager {
    constructor() {
        this.iron = 100;
        this.titanium = 20;
    }

    /**
     * Evaluates all active harvesters on the global tick to feed global storage bins
     * @param {ResourceDeposit[]} globalDepositsList - Array containing all deposits on the map
     */
    processHarvestingLoop(globalDepositsList) {
        globalDepositsList.forEach(deposit => {
            if (deposit.hasHarvester && !deposit.isDepleted) {
                if (deposit.type === 'IRON') {
                    const dynamicAmount = deposit.extractOre(10); // Iron harvest speed rate
                    this.iron += dynamicAmount;
                    console.log(`[MINING LOG] Harvested +${dynamicAmount} Iron from coordinate [${deposit.x},${deposit.y}]`);
                } 
                else if (deposit.type === 'TITANIUM') {
                    const dynamicAmount = deposit.extractOre(4);  // Titanium is rarer, harvests slower
                    this.titanium += dynamicAmount;
                    console.log(`[MINING LOG] Harvested +${dynamicAmount} Titanium from coordinate [${deposit.x},${deposit.y}]`);
                }
            }
        });
    }
}
