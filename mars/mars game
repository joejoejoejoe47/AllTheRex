class SecurableCity {
    constructor(name, x, y, protectionRadius = 2) {
        this.name = name;
        this.x = x;
        this.y = y;
        this.protectionRadius = protectionRadius; // Range checked for military coverage
        this.isSecure = false;
        this.happiness = 50;
    }

    /**
     * Checks if any active player military units are stationed within the guard perimeter
     * @param {TacticalUnit[]} playerTroopsList - Current pool of alive player forces
     */
    evaluateSecurityPerimeter(playerTroopsList) {
        let troopFoundInRange = false;

        for (let troop of playerTroopsList) {
            if (troop.isDead) continue;

            // Calculate Chebyshev distance (representing a square-radius block scan)
            const distX = Math.abs(this.x - troop.x);
            const distY = Math.abs(this.y - troop.y);
            const distance = Math.max(distX, distY);

            if (distance <= this.protectionRadius) {
                troopFoundInRange = true;
                break; // One patrol unit is enough to secure the dome bounds
            }
        }

        const previousState = this.isSecure;
        this.isSecure = troopFoundInRange;

        if (this.isSecure !== previousState) {
            if (this.isSecure) {
                console.log(`[SECURE] ${this.name} is now heavily protected. Citizens feel safe!`);
                this.happiness = Math.min(100, this.happiness + 15); // Dynamic happiness booster
            } else {
                console.warn(`[VULNERABLE] Patrols have left! ${this.name} has lost active military coverage.`);
                this.happiness = Math.max(0, this.happiness - 20); // Panic drops morale
            }
        }
    }
}

class AlienSpawner {
    /**
     * @param {number} mapWidth 
     * @param {number} mapHeight 
     */
    constructor(mapWidth, mapHeight) {
        this.mapWidth = mapWidth;
        this.mapHeight = mapHeight;
        this.spawnedAliens = [];
    }

    /**
     * Periodically launches hostiles from random coordinate edges
     */
    spawnInvasionForce() {
        // Choose a random outer border edge coordinate
        const spawnAtX = Math.random() > 0.5 ? 0 : this.mapWidth - 1;
        const spawnAtY = Math.floor(Math.random() * this.mapHeight);

        const newAlien = new TacticalUnit(
            `ALIEN_${Math.floor(Math.random() * 9000) + 1000}`,
            'ALIEN',
            spawnAtX,
            spawnAtY,
            8 // Threat level rating
        );

        this.spawnedAliens.push(newAlien);
        console.log(`[ALARM] Hostile bio-signature registered at edge coordinates [${spawnAtX},${spawnAtY}]!`);
        return newAlien;
    }

    /**
     * Directs active alien units toward their nearest urban target coordinates
     * @param {SecurableCity[]} cityList - List of current potential targets
     */
    processInvasionPathfinding(cityList) {
        if (cityList.length === 0) return;

        this.spawnedAliens.forEach(alien => {
            if (alien.isDead) return;

            // 1. Locate the nearest colony dome target
            let nearestCity = cityList[0];
            let shortestDistance = Infinity;

            cityList.forEach(city => {
                const distance = Math.hypot(city.x - alien.x, city.y - alien.y);
                if (distance < shortestDistance) {
                    shortestDistance = distance;
                    nearestCity = city;
                }
            });

            // 2. Step 1 tile closer to the target (simple path calculation)
            const stepX = Math.sign(nearestCity.x - alien.x);
            const stepY = Math.sign(nearestCity.y - alien.y);

            alien.x += stepX;
            alien.y += stepY;

            console.log(`[THREAT MOVE] ${alien.id} marching forward. Now at [${alien.x},${alien.y}] tracking toward ${nearestCity.name}.`);

            // 3. Evaluate strike zone arrival
            if (alien.x === nearestCity.x && alien.y === nearestCity.y) {
                console.error(`[STRIKE] ${alien.id} has breached the dome at ${nearestCity.name}! Panic spreads.`);
                nearestCity.happiness = Math.max(0, nearestCity.happiness - 40);
                alien.isDead = true; // Alien expends itself in the destruction run
            }
        });

        // Keep active array clear of dead threats
        this.spawnedAliens = this.spawnedAliens.filter(alien => !alien.isDead);
    }
}
using Unity.Netcode;
using UnityEngine;

public class NetworkTerraformer : NetworkBehaviour
{
    // These variables automatically synchronize from the Server to all Clients
    public NetworkVariable<int> centerX = new NetworkVariable<int>();
    public NetworkVariable<int> centerY = new NetworkVariable<int>();
    public NetworkVariable<float> progressPercent = new NetworkVariable<float>(0f);
    public NetworkVariable<bool> isComplete = new NetworkVariable<bool>(false);

    private float timer = 30f; // 30s cycle for Small Terraformer

    private void Update()
    {
        // Rule: Only the server calculates the time and progresses the game loop!
        if (!IsServer) return; 

        if (isComplete.Value) return;

        // Code Constraint: Check if the owner's company is still solvent/running
        bool isCompanyOperational = CheckOwnerCompanyStatus(OwnerClientId);

        if (isCompanyOperational)
        {
            timer -= Time.deltaTime;
            progressPercent.Value = Mathf.Clamp(((30f - timer) / 30f) * 100f, 0f, 100f);

            if (timer <= 0f)
            {
                TriggerGridConversionServer();
            }
        }
        else
        {
            // If the company is offline, progress stops. The status updates dynamically on clients.
            Debug.LogWarning($"Terraformer belonging to Client {OwnerClientId} stalled. Company unpaid.");
        }
    }

    private void TriggerGridConversionServer()
    {
        isComplete.Value = true;
        
        // Update the global master map on the server
        MultiplayerMapManager.Instance.ConvertTileGrid(centerX.Value, centerY.Value, radius: 1);
        
        // Notify all clients to trigger local visual/particle effects
        PlayConversionEffectsClientRpc();
    }

    [ClientRpc]
    private void PlayConversionEffectsClientRpc()
    {
        // This runs on EVERY player's machine to show the cool blue terraform flash!
        VisualEffectsManager.Instance.SpawnTerraformFlash(centerX.Value, centerY.Value);
    }

    private bool CheckOwnerCompanyStatus(ulong clientId)
    {
        // Server references the specific player's economy records
        return MultiplayerEconomyManager.Instance.GetPlayerSolvency(clientId);
    }
}
class AICorporateCompetitor {
    constructor(id, name, startingX, startingY) {
        this.id = id;
        this.name = name;
        this.baseCoordinates = { x: startingX, y: startingY };

        // Threshold values defining AI comfort limits
        this.CREDIT_MINIMUM_THRESHOLD = 200;
        this.SCIENCE_MINIMUM_THRESHOLD = 30;
        this.SECURITY_ALERT_RADIUS = 3; // Tiles
    }

    /**
     * Primary entry point called during the Global Tick
     * @param {object} aiState - Current parameters representing the AI's status
     * @param {MarsSectorMap} map - Reference to the global grid
     */
    thinkAndExecute(aiState, map) {
        console.log(`[AI DECISION] Bot "${this.name}" is processing choices...`);

        // PRIORITY 1: Check Credit Balance
        if (aiState.credits < this.CREDIT_MINIMUM_THRESHOLD) {
            this.buildCommercialMarket(aiState);
            return; // Action executed, end tick turn
