class MilitaryBase {
    /**
     * @param {number} x - Location on the 2D grid
     * @param {number} y - Location on the 2D grid
     * @param {MarsSectorMap} mapInstance - The active spatial coordinate grid
     */
    constructor(x, y, mapInstance) {
        this.x = x;
        this.y = y;
        this.deployedTroops = [];
        
        // CODE CONSTRAINT: Validate construction ground suitability
        const targetTile = mapInstance.grid[x][y];
        if (!targetTile.isTerraformed) {
            throw new Error(`Construction Failed: Cannot establish military foundations at [${x},${y}] without stabilized, terraformed ground.`);
        }
        
        // Lock this coordinate down as occupied
        targetTile.occupyingStructure = "MILITARY_BASE";
        console.log(`[MILITARY CMD] Firebase established at [${x},${y}]. Foundries online.`);
    }

    /**
     * Standard Troop Spawner routine
     * @param {string} troopType - 'SOLDIER' or 'TANK'
     * @param {object} playerGlobalWallet - Reference to the global wallet (Step 1.1)
     * @param {InventoryManager} playerInventory - Reference to the raw materials vault (Step 3.1)
     */
    spawnTroop(troopType, playerGlobalWallet, playerInventory) {
        const blueprint = TROOP_BLUEPRINTS[troopType];
        
        if (!blueprint) {
            console.error(`Tactical registry error: Unknown unit prototype [${troopType}]`);
            return null;
        }

        // Validate complete financial and logistical resource coverage
        const hasCredits = playerGlobalWallet.credits >= blueprint.creditCost;
        const hasIron    = playerInventory.iron >= blueprint.ironCost;
        const hasTitanium = playerInventory.titanium >= blueprint.titaniumCost;

        if (!hasCredits || !hasIron || !hasTitanium) {
            console.warn(`[REJECTED] Cannot authorize unit assembly. Shortages detected:`);
            console.warn(`- Credits: ${playerGlobalWallet.credits}/${blueprint.creditCost}`);
            console.warn(`- Iron: ${playerInventory.iron}/${blueprint.ironCost}`);
            console.warn(`- Titanium: ${playerInventory.titanium}/${blueprint.titaniumCost}`);
            return null;
        }

        // Deduct assembly costs from storage
        playerGlobalWallet.credits -= blueprint.creditCost;
        playerInventory.iron -= blueprint.ironCost;
        playerInventory.titanium -= blueprint.titaniumCost;

        // Construct tactical unit payload
        const newUnit = {
            id: `UNIT_${Math.floor(Math.random() * 9000) + 1000}`,
            model: blueprint.name,
            power: blueprint.securityRating,
            deployedAt: { x: this.x, y: this.y }
        };

        this.deployedTroops.push(newUnit);
        console.log(`[ASSEMBLY SUCCESS] Deployed 1x ${newUnit.model} (${newUnit.id}) at base coordinates [${this.x},${this.y}]`);
        return newUnit;
    }
}
