<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Make index.php the default page for this folder (the site root also has index.html / Default.aspx). -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <!-- Never serve code/config/tests over HTTP. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="lib" />
          <add segment="cli" />
          <add segment="tests" />
          <add segment="config.php" />
          <add segment="config.sample.php" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
