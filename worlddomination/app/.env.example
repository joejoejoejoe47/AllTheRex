# Copy to .env and fill in. Real environment variables win over this file.
# Never commit .env.

# --- MySQL / MariaDB (production on Plesk) ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=world_domination
DB_USER=worlddom
DB_PASS=change-me
# DB_SOCKET=/tmp/mysql.sock

# --- or SQLite: fine for local play and tests ---
# DB_DRIVER=sqlite
# DB_SQLITE=storage/worlddom.sqlite

# Public origin (optional; derived from the request if unset)
# APP_URL=https://alltherex.com/worlddomination
# TRUSTED_ORIGINS=
APP_DEBUG=0
