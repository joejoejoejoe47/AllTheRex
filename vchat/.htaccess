# Apache (Plesk): keep private files private and don't list folders.
Options -Indexes
<FilesMatch "^(config(\.sample)?\.php|.*\.(sqlite|sql|md))$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
