# Copy to .env and fill in. Never commit .env.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# REQUIRED in production: long random string (e.g. `openssl rand -hex 32`). Signs login cookies.
SESSION_SECRET=
SESSION_TTL_DAYS=14
# Set to 1 when served over HTTPS (it is forced on when NODE_ENV=production).
COOKIE_SECURE=0
# Set to 1 only when behind a reverse proxy you control (uses X-Forwarded-For for rate limits).
TRUST_PROXY=0
# Extra allowed Origins for the websocket, comma separated. Same-host origins are always allowed.
ALLOWED_ORIGINS=

# Max people in one meeting (hard-capped at 20).
MAX_PARTICIPANTS=20

# --- Google sign-in ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Add your site (and http://localhost:3000 for testing) to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# --- Phone sign-in (SMS code, then authenticator-app 2nd step) ---
# console = print codes in the server log (development only). twilio = send real SMS.
SMS_MODE=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Shown in the authenticator app
TOTP_ISSUER=AllTheRex vchat
# Max SMS codes requested per IP per hour (raise if many users share one network)
SMS_IP_LIMIT=15

# --- WebRTC ---
STUN_URLS=stun:stun.l.google.com:19302
# TURN is strongly recommended: ~10-15% of users cannot connect without it.
# Option A: coturn with `use-auth-secret` (ephemeral credentials generated per user)
TURN_URLS=
TURN_SECRET=
# Option B: static credentials (e.g. a hosted TURN provider)
TURN_USERNAME=
TURN_CREDENTIAL=
